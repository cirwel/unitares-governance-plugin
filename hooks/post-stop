#!/usr/bin/env bash
# UNITARES Governance Plugin — Stop hook
#
# Fires once per host turn (when the client stops emitting actions).
# Reads the Stop hook JSON payload on stdin, builds a turn summary,
# submits a process_agent_update via scripts/checkin.py, exits fast.
#
# Claude invokes this asynchronously. Codex invokes it synchronously with
# bounded onboard and check-in budgets below the manifest's outer timeout.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

HOOK_HOST="claude"
HOOK_MODE="stop"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --host)
      if [[ $# -ge 2 && -n "${2:-}" ]]; then
        HOOK_HOST="$2"
        shift 2
      else
        shift
      fi
      ;;
    --session-start)
      HOOK_MODE="session_start"
      shift
      ;;
    *)
      shift
      ;;
  esac
done
if [[ "${HOOK_HOST}" != "claude" && "${HOOK_HOST}" != "codex" && "${HOOK_HOST}" != "agy" ]]; then
  exit 0
fi
# Codex and Antigravity (agy) treat empty or plain-text stdout from a
# successful Stop or SessionStart hook as an invalid response. Emit one neutral
# JSON object on every synchronous host exit path; Claude's asynchronous Stop
# hook remains silent.
_emit_codex_stop_output() {
  [[ "${HOOK_HOST}" == "codex" || "${HOOK_HOST}" == "agy" ]] && printf '{}\n'
}
trap _emit_codex_stop_output EXIT

HOST_MODEL_TYPE="codex"
[[ "${HOOK_HOST}" == "claude" ]] && HOST_MODEL_TYPE="claude-code"
[[ "${HOOK_HOST}" == "agy" ]] && HOST_MODEL_TYPE="antigravity"

# Codex and agy Stop have a 30-second outer timeout. Keep network work at or
# below 20 seconds so payload normalization, cache I/O, and process startup
# retain a meaningful margin. A pending continuity answer (only after an
# opted-in compaction) adds at most 3 seconds, capped by its own wall clock.
# Operator overrides may lower these caps, never raise them for Codex/agy.
# Claude's asynchronous hook keeps the configured defaults.
CODEX_ONBOARD_TIMEOUT_CAP="5"
CODEX_CHECKIN_TIMEOUT_CAP="15"

_timeout_at_most() {
  if command -v awk >/dev/null 2>&1; then
    _TMO_VAL="${1:-}" _TMO_CAP="${2:-}" LC_ALL=C awk 'BEGIN {
      val = ENVIRON["_TMO_VAL"]
      c = ENVIRON["_TMO_CAP"] + 0
      gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", val)
      if (val ~ /^[+-]?(([0-9]+([.][0-9]*)?)|([.][0-9]+))([eE][+-]?[0-9]+)?$/) {
        v = val + 0
        if (v > 0 && v < c) {
          printf "%g\n", v
          exit 0
        }
      }
      printf "%g\n", c
    }' 2>/dev/null || printf '%s\n' "$2"
  else
    printf '%s\n' "$2"
  fi
}

DEFAULTS_FILE=""
for candidate in \
  "${PLUGIN_ROOT}/config/defaults.env" \
  "${PLUGIN_ROOT}/config/client/defaults.env"
do
  if [[ -f "${candidate}" ]]; then
    DEFAULTS_FILE="${candidate}"
    break
  fi
done

SERVER_URL_OVERRIDE="${UNITARES_SERVER_URL-}"
CHECKINS_OVERRIDE="${UNITARES_CHECKINS-}"
CHECKIN_LOG_OVERRIDE="${UNITARES_CHECKIN_LOG-}"
AUTO_ONBOARD_OVERRIDE="${UNITARES_AUTO_ONBOARD-}"
DISABLE_AUTO_ONBOARD_OVERRIDE="${UNITARES_DISABLE_AUTO_ONBOARD-}"
AGENT_NAME_OVERRIDE="${UNITARES_AGENT_NAME-}"
AGENT_PREFIX_OVERRIDE="${UNITARES_AGENT_PREFIX-}"
MODEL_TYPE_OVERRIDE="${UNITARES_MODEL_TYPE-}"
AUTO_ONBOARD_TIMEOUT_OVERRIDE="${UNITARES_AUTO_ONBOARD_TIMEOUT-}"
if [[ -n "${DEFAULTS_FILE}" ]]; then
  # shellcheck source=/dev/null
  source "${DEFAULTS_FILE}" 2>/dev/null || true
fi
if [[ -n "${SERVER_URL_OVERRIDE}" ]]; then
  UNITARES_SERVER_URL="${SERVER_URL_OVERRIDE}"
fi
if [[ -n "${CHECKINS_OVERRIDE}" ]]; then
  UNITARES_CHECKINS="${CHECKINS_OVERRIDE}"
fi
if [[ -n "${CHECKIN_LOG_OVERRIDE}" ]]; then
  UNITARES_CHECKIN_LOG="${CHECKIN_LOG_OVERRIDE}"
fi
if [[ -n "${AUTO_ONBOARD_OVERRIDE}" ]]; then
  UNITARES_AUTO_ONBOARD="${AUTO_ONBOARD_OVERRIDE}"
fi
if [[ -n "${DISABLE_AUTO_ONBOARD_OVERRIDE}" ]]; then
  UNITARES_DISABLE_AUTO_ONBOARD="${DISABLE_AUTO_ONBOARD_OVERRIDE}"
fi
if [[ -n "${AGENT_NAME_OVERRIDE}" ]]; then
  UNITARES_AGENT_NAME="${AGENT_NAME_OVERRIDE}"
fi
if [[ -n "${AGENT_PREFIX_OVERRIDE}" ]]; then
  UNITARES_AGENT_PREFIX="${AGENT_PREFIX_OVERRIDE}"
elif [[ "${HOOK_HOST}" == "codex" ]]; then
  UNITARES_AGENT_PREFIX="codex"
elif [[ "${HOOK_HOST}" == "agy" ]]; then
  UNITARES_AGENT_PREFIX="agy"
fi
if [[ -n "${MODEL_TYPE_OVERRIDE}" ]]; then
  UNITARES_MODEL_TYPE="${MODEL_TYPE_OVERRIDE}"
elif [[ "${HOOK_HOST}" == "codex" ]]; then
  UNITARES_MODEL_TYPE="codex"
elif [[ "${HOOK_HOST}" == "agy" ]]; then
  UNITARES_MODEL_TYPE="antigravity"
fi
if [[ -n "${AUTO_ONBOARD_TIMEOUT_OVERRIDE}" ]]; then
  UNITARES_AUTO_ONBOARD_TIMEOUT="${AUTO_ONBOARD_TIMEOUT_OVERRIDE}"
fi
SERVER_URL="${UNITARES_SERVER_URL:-http://localhost:8767}"
ONBOARD_TIMEOUT="${UNITARES_AUTO_ONBOARD_TIMEOUT:-10}"
CHECKIN_TIMEOUT="${UNITARES_CHECKIN_TIMEOUT:-20}"
if [[ "${HOOK_HOST}" == "codex" || "${HOOK_HOST}" == "agy" ]]; then
  ONBOARD_TIMEOUT="$(_timeout_at_most "${ONBOARD_TIMEOUT}" "${CODEX_ONBOARD_TIMEOUT_CAP}")"
  CHECKIN_TIMEOUT="$(_timeout_at_most "${CHECKIN_TIMEOUT}" "${CODEX_CHECKIN_TIMEOUT_CAP}")"
fi

ORCHESTRATED_MODE="$(printf '%s' "${UNITARES_ORCHESTRATED:-0}" | tr '[:upper:]' '[:lower:]')"
ANCHOR_RESUME_ENABLED=0
if [[ -n "${UNITARES_CLIENT_SESSION_ID:-}" \
      && ( "${ORCHESTRATED_MODE}" == "1" \
           || "${ORCHESTRATED_MODE}" == "true" \
           || "${ORCHESTRATED_MODE}" == "yes" \
           || "${ORCHESTRATED_MODE}" == "on" ) \
      && -n "${UNITARES_ORCHESTRATED_OWNER_PID:-}" \
      && "${UNITARES_HOOK_HOST_PID:-}" == "${UNITARES_ORCHESTRATED_OWNER_PID}" ]]; then
  ANCHOR_RESUME_ENABLED=1
fi

# SessionStart mode (--session-start) is strictly for pre-binding orchestrated
# thread anchors (e.g. dispatch_beam Turn 1) so GitHub writes during Turn 1
# carry the thread's UNITARES agent UUID before the first Stop. Interactive
# sessions drain stdin and exit immediately in pure bash without spawning
# Python or touching the network, preserving explicit Turn-1 start_session().
if [[ "${HOOK_MODE}" == "session_start" && "${ANCHOR_RESUME_ENABLED}" != "1" ]]; then
  cat >/dev/null 2>&1 || true
  exit 0
fi

# Read stdin once for host normalization and session-cache lookup.
PAYLOAD=$(cat 2>/dev/null || echo "{}")
[[ -z "${PAYLOAD}" ]] && PAYLOAD="{}"

STOP_EVENT_HELPER="${PLUGIN_ROOT}/scripts/stop_hook_event.py"
if [[ ! -f "${STOP_EVENT_HELPER}" ]]; then
  exit 0
fi
HOOK_STOP_WORKSPACE=""
if [[ "${HOOK_HOST}" == "claude" ]]; then
  HOOK_STOP_WORKSPACE="${CLAUDE_PROJECT_DIR:-${PWD}}"
elif [[ "${HOOK_HOST}" == "codex" ]]; then
  HOOK_STOP_WORKSPACE="${PWD}"
fi
unset STOP_FORMAT_OK STOP_WORKSPACE_DIR STOP_IS_SUBAGENT STOP_HOST_SESSION_ID \
  STOP_FLOOR_TOOLS STOP_FLOOR_SUMMARY STOP_SUMMARY STOP_COMPLEXITY \
  STOP_MODEL STOP_MODEL_PROVIDER STOP_MODEL_SOURCE \
  STOP_HARNESS_TYPE STOP_HARNESS_VERSION STOP_HARNESS_SOURCE
STOP_EVENT_ARGS=(--host="${HOOK_HOST}" --workspace="${HOOK_STOP_WORKSPACE}" --format=shell)
if [[ "${HOOK_MODE}" == "session_start" ]]; then
  STOP_EVENT_ARGS+=(--session-start)
else
  STOP_EVENT_ARGS+=(--probe-git)
fi
if [[ "${HOOK_HOST}" == "agy" && "${ANCHOR_RESUME_ENABLED}" == "1" ]]; then
  STOP_EVENT_ARGS+=(
    "--agy-anchor=${UNITARES_CLIENT_SESSION_ID}"
    "--agy-owner-pid=${UNITARES_ORCHESTRATED_OWNER_PID}"
  )
fi
if ! STOP_VARS=$(printf '%s' "${PAYLOAD}" | python3 "${STOP_EVENT_HELPER}" \
  "${STOP_EVENT_ARGS[@]}" 2>/dev/null); then
  exit 0
fi
eval "${STOP_VARS}"
if [[ "${STOP_FORMAT_OK:-}" != "1" ]]; then
  exit 0
fi

# Resolve slot-aware session cache via shared helper.
SESSION_LOOKUP="${PLUGIN_ROOT}/scripts/_session_lookup.py"
if [[ ! -f "${SESSION_LOOKUP}" ]]; then
  exit 0
fi
AGY_WORKSPACE=""
AGY_IS_SUBAGENT="false"
if [[ "${HOOK_HOST}" == "agy" ]]; then
  AGY_WORKSPACE="${STOP_WORKSPACE_DIR:-}"
  AGY_IS_SUBAGENT="${STOP_IS_SUBAGENT:-false}"
  LOOKUP_WORKSPACE="${AGY_WORKSPACE:-${HOME}}"
else
  LOOKUP_WORKSPACE="${PWD}"
fi
eval "$(printf '%s' "${PAYLOAD}" | python3 "${SESSION_LOOKUP}" --workspace "${LOOKUP_WORKSPACE}")"

# Antigravity's PostToolUse payload does not carry MCP tool_response on stdin,
# so an explicit start_session/onboard call during the turn is recorded in the
# conversation transcript before it reaches the slot cache. Recover or upgrade
# it before deciding whether the slot is unbound.
if [[ "${HOOK_HOST}" == "agy" && "${HOOK_MODE}" != "session_start" && -n "${RAW_SLOT:-}" ]]; then
  if printf '%s' "${PAYLOAD}" | python3 "${STOP_EVENT_HELPER}" \
      --host agy \
      --recover-agy-identity \
      --workspace "${LOOKUP_WORKSPACE}" \
      --slot "${RAW_SLOT}" >/dev/null 2>&1; then
    eval "$(printf '%s' "${PAYLOAD}" | python3 "${SESSION_LOOKUP}" --workspace "${LOOKUP_WORKSPACE}")"
  fi
fi

# Antigravity invoke_subagent child conversations (detected via transcript step 0,
# parentConversationId, or fcntl.flock anchor ownership in stop_hook_event.py)
# share the parent's HOME hooks and OS PID. Skip lazy onboarding and floor
# telemetry when the child did not explicitly bind its own governance session.
if [[ "${HOOK_HOST}" == "agy" && -z "${CSID:-}" \
      && ( "${AGY_IS_SUBAGENT}" == "True" || "${AGY_IS_SUBAGENT}" == "true" ) ]]; then
  exit 0
fi

# Codex has no failed-tool post hook. Reclaim only this session's unused
# PreToolUse check-in snapshots at the synchronous turn boundary; snapshots
# from other concurrent sessions in the workspace remain untouched.
SNAPSHOT_SLOT=""
SLOT_HELPER="${PLUGIN_ROOT}/scripts/_slot_from_stdin.py"
if [[ "${HOOK_HOST}" == "codex" && "${HOOK_MODE}" != "session_start" && -f "${SLOT_HELPER}" ]]; then
  SNAPSHOT_SLOT=$(printf '%s' "${PAYLOAD}" | python3 "${SLOT_HELPER}" 2>/dev/null || true)
fi
if [[ "${HOOK_HOST}" == "codex" && "${HOOK_MODE}" != "session_start" && -n "${SNAPSHOT_SLOT}" ]]; then
  SESSION_CACHE_HELPER="${PLUGIN_ROOT}/scripts/session_cache.py"
  if [[ -f "${SESSION_CACHE_HELPER}" ]]; then
    python3 "${SESSION_CACHE_HELPER}" discard-milestone-snapshots \
      --workspace "${PWD}" \
      --slot "${SNAPSHOT_SLOT}" >/dev/null 2>&1 || true
  fi
fi

# If the agent did not explicitly onboard before the turn ended (or at
# SessionStart for an orchestrated anchor), provision a slot-scoped identity.
# This is harness-managed attribution for the host process, not an
# agent-authored claim. onboard_helper.py owns the safety constraints:
# force_new=true, per-slot name scoping, lineage via parent_agent_id, no
# persisted continuity token.
CHECKINS_MODE="$(printf '%s' "${UNITARES_CHECKINS:-on}" | tr '[:upper:]' '[:lower:]')"
AUTO_ONBOARD_MODE="$(printf '%s' "${UNITARES_AUTO_ONBOARD:-off}" | tr '[:upper:]' '[:lower:]')"
DISABLE_AUTO_ONBOARD="$(printf '%s' "${UNITARES_DISABLE_AUTO_ONBOARD:-0}" | tr '[:upper:]' '[:lower:]')"
if [[ -z "${CSID:-}" && -n "${RAW_SLOT:-}" \
      && "${CHECKINS_MODE}" != "off" \
      && "${AUTO_ONBOARD_MODE}" != "0" \
      && "${AUTO_ONBOARD_MODE}" != "off" \
      && "${AUTO_ONBOARD_MODE}" != "false" \
      && "${AUTO_ONBOARD_MODE}" != "no" \
      && "${DISABLE_AUTO_ONBOARD}" != "1" \
      && "${DISABLE_AUTO_ONBOARD}" != "true" \
      && "${DISABLE_AUTO_ONBOARD}" != "on" ]]; then
  ONBOARD_HELPER="${PLUGIN_ROOT}/scripts/onboard_helper.py"
  if [[ -f "${ONBOARD_HELPER}" ]]; then
    # Name the session after the directory it was started in. $PWD is wherever
    # the shell happens to be at the first Stop, which can be anywhere.
    # CLAUDE_PROJECT_DIR is Claude Code's launch directory, consulted only for
    # the Claude host: a Codex session can inherit it from a Claude-managed
    # environment, and must keep its own $PWD.
    WORKSPACE_DIR="${PWD}"
    WORKSPACE_NAME="$(basename "${WORKSPACE_DIR}")"
    if [[ "${HOOK_HOST}" == "claude" && -n "${CLAUDE_PROJECT_DIR:-}" ]]; then
      WORKSPACE_DIR="${CLAUDE_PROJECT_DIR}"
      WORKSPACE_NAME="$(basename "${WORKSPACE_DIR}")"
    elif [[ "${HOOK_HOST}" == "agy" ]]; then
      if [[ -n "${AGY_WORKSPACE:-}" ]]; then
        WORKSPACE_DIR="${AGY_WORKSPACE}"
        WORKSPACE_NAME="$(basename "${WORKSPACE_DIR}")"
      else
        WORKSPACE_DIR="${HOME}"
        WORKSPACE_NAME="antigravity"
      fi
    fi
    AGENT_NAME="${UNITARES_AGENT_NAME:-${UNITARES_AGENT_PREFIX:-${HOOK_HOST}}-${WORKSPACE_NAME}}"
    MODEL_TYPE="${UNITARES_MODEL_TYPE:-${HOST_MODEL_TYPE}}"
    # Resume anchor (UNITARES_CLIENT_SESSION_ID, e.g. "agent:/thread-<id>") is
    # honored only when the spawner also declares UNITARES_ORCHESTRATED=1. That
    # fail-closed marker lets headless orchestrated turn-children resume one
    # identity across turns while a leaked bare anchor in an interactive shell
    # falls back to normal fresh-mint behavior.
    python3 "${ONBOARD_HELPER}" \
      --server-url "${SERVER_URL}" \
      --name "${AGENT_NAME}" \
      --model-type "${MODEL_TYPE}" \
      --workspace "${LOOKUP_WORKSPACE}" \
      --slot "${RAW_SLOT}" \
      --client-session-id "${UNITARES_CLIENT_SESSION_ID:-}" \
      --host-harness "${HOST_MODEL_TYPE}" \
      --host-session-id "${STOP_HOST_SESSION_ID:-}" \
      --host-session-dir "${WORKSPACE_DIR}" \
      --timeout "${ONBOARD_TIMEOUT}" \
      >/dev/null 2>&1 || true
    eval "$(printf '%s' "${PAYLOAD}" | python3 "${SESSION_LOOKUP}" --workspace "${LOOKUP_WORKSPACE}")"
  fi
fi

# Record that this bound slot is active. A binding idle past the server's
# session lifetime is instead marked prior_process: the host resumed an earlier
# session without SessionStart (Codex often does), so this process has not
# minted its own identity yet (scripts/binding_activity.py).
if [[ -n "${CSID:-}" && -f "${PLUGIN_ROOT}/scripts/binding_activity.py" ]]; then
  printf '%s' "${PAYLOAD}" | python3 "${PLUGIN_ROOT}/scripts/binding_activity.py" mark \
    --workspace "${LOOKUP_WORKSPACE}" >/dev/null 2>&1 || true
  # Re-read: a binding just marked prior_process belongs to the earlier
  # process, so this turn's evidence must not be sent under it.
  eval "$(printf '%s' "${PAYLOAD}" | python3 "${SESSION_LOOKUP}" --workspace "${LOOKUP_WORKSPACE}")"
fi

if [[ "${HOOK_MODE}" == "session_start" ]]; then
  exit 0
fi

# The opt-in continuity question asked at a compaction is answered at the end
# of that turn: the script reads the agent's last message for its answer line
# and records it beside the compaction (scripts/continuity_probe.py). It
# consumes this slot's marker whatever happens, and does nothing without one.
# A shell glob first, so a Stop with no pending question starts no Python.
PROBE_HELPER="${PLUGIN_ROOT}/scripts/continuity_probe.py"
if [[ -f "${PROBE_HELPER}" ]] && compgen -G "${HOME}/.unitares/*.continuity-probe" >/dev/null; then
  printf '%s' "${PAYLOAD}" | python3 "${PROBE_HELPER}" \
    --host "${HOOK_HOST}" --server-url "${SERVER_URL}" >/dev/null 2>&1 || true
fi

# No onboarded identity (no CSID) after lazy onboarding → don't go dark. Emit
# one identity-free substrate FLOOR observation: a measurement that this
# session ran, NOT an identity claim. It writes to core.substrate_observations
# via a separate endpoint that never touches the identity path. RAW_SLOT is
# the raw host session_id from stdin, present even when no onboard cache
# exists.
if [[ -z "${CSID:-}" ]]; then
  if [[ -n "${RAW_SLOT:-}" ]]; then
    python3 "${PLUGIN_ROOT}/scripts/substrate_floor.py" \
      --slot "${RAW_SLOT}" \
      --event turn_stop \
      --tool-count "${STOP_FLOOR_TOOLS}" \
      --summary "${STOP_FLOOR_SUMMARY}" \
      >/dev/null 2>&1 || true
  fi
  exit 0
fi

# No --confidence: this turn summary is a substrate reading of tool shape, not
# an agent's belief about its own work. A supplied value mints a tactical
# prediction server-side and is scored into the fleet calibration curve.
python3 "${PLUGIN_ROOT}/scripts/checkin.py" \
  --event turn_stop \
  --response-text "${STOP_SUMMARY}" \
  --complexity "${STOP_COMPLEXITY}" \
  --epistemic-class substrate_interpretation \
  --client-session-id "${CSID}" \
  --uuid "${UUID}" \
  --slot "${SLOT:-${RAW_SLOT:-}}" \
  --timeout "${CHECKIN_TIMEOUT}" \
  --model "${STOP_MODEL}" \
  --model-provider "${STOP_MODEL_PROVIDER}" \
  --model-source "${STOP_MODEL_SOURCE}" \
  --harness-type "${STOP_HARNESS_TYPE}" \
  --harness-version "${STOP_HARNESS_VERSION}" \
  --harness-source "${STOP_HARNESS_SOURCE}" \
  >/dev/null 2>&1 || true

# Optional outcome evidence follows the primary check-in so it cannot delay it.
# Tool outcomes for the part of the transcript this Stop closes. Counts
# only, sent as identity-bound host evidence; nothing in it is scored and it
# does not alter the check-in above. Disable with UNITARES_TOOL_OUTCOMES=off.
if [[ ( "${HOOK_HOST}" == "claude" || "${HOOK_HOST}" == "codex" ) && -f "${PLUGIN_ROOT}/scripts/tool_outcomes.py" ]]; then
  printf '%s' "${PAYLOAD}" | python3 "${PLUGIN_ROOT}/scripts/tool_outcomes.py" \
    --host "${HOOK_HOST}" \
    --uuid "${UUID}" \
    --client-session-id "${CSID}" \
    --slot "${RAW_SLOT:-${SLOT:-}}" \
    --server-url "${SERVER_URL}" \
    >/dev/null 2>&1 || true
fi

exit 0
