#!/usr/bin/env bash
# UNITARES Governance Plugin — SessionEnd hook
#
# Fires when the host session terminates (window close, etc). Both hosts use
# this only for bounded lease cleanup: local file leases and the session's
# governance presence lease. Claude gives plugin-provided
# SessionEnd hooks a shared 1.5-second budget that a manifest timeout cannot
# raise, so turn-level governance delivery belongs to Stop instead.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

HOOK_HOST="claude"
if [[ "${1:-}" == "--host" && -n "${2:-}" ]]; then
  HOOK_HOST="$2"
fi
if [[ "${HOOK_HOST}" != "claude" && "${HOOK_HOST}" != "codex" ]]; then
  exit 0
fi

PAYLOAD=$(cat 2>/dev/null || echo "{}")
[[ -z "${PAYLOAD}" ]] && PAYLOAD="{}"

# Release any file leases held by this host session. Run this before the
# deadline expires; PostToolUse and Stop are the primary release paths, while
# TTL remains the crash backstop.
FILE_LEASE_HELPER="${PLUGIN_ROOT}/scripts/file_lease_hook.py"
if [[ -f "${FILE_LEASE_HELPER}" ]]; then
  printf '%s' "${PAYLOAD}" | python3 "${FILE_LEASE_HELPER}" release-session \
    --workspace "${PWD}" --host "${HOOK_HOST}" --budget 0.8 >/dev/null 2>&1 &
fi

# Release this session's governance presence lease, in parallel with the file
# leases so both fit the shared budget. Without it, an exited session reads as
# live until the server-side TTL, and a successor that declares it as parent in
# that window is refused as co-located. This sends no check-in.
PRESENCE_HELPER="${PLUGIN_ROOT}/scripts/presence_release.py"
if [[ -f "${PRESENCE_HELPER}" ]]; then
  printf '%s' "${PAYLOAD}" | python3 "${PRESENCE_HELPER}" \
    --workspace "${PWD}" --budget 0.6 >/dev/null 2>&1 &
fi

wait
exit 0
