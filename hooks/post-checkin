#!/usr/bin/env bash
# UNITARES Governance Plugin — PostToolUse hook (process_agent_update)
#
# Fires whenever the agent calls the process_agent_update MCP tool directly
# (e.g. via /checkin). Resets the milestone accumulator and stamps
# session.last_checkin_ts so the post-edit auto-checkin hook does not
# immediately re-fire on the next edit.
#
# This is what makes manual check-ins authoritative. Prior to this hook,
# keeping the accumulator in sync relied on /checkin.md guidance that the
# agent had to follow by hand — reliable enough to ship, not reliable enough
# to keep relying on.
#
# Slot derivation (S20.1a, 2026-04-26): the `last_checkin_ts` write must land
# in the slot-scoped session cache, not the legacy flat session.json — flat
# writes silently brick the auto-checkin forcing function (post-edit reads
# the slotted cache via _session_lookup, which the post-PR-19 contract
# scopes to slot-only). The slot is strictly the host session_id
# from hook stdin; cache-stored `slot` fields are not consulted as a
# fallback because a stale legacy flat cache may carry a slot value from a
# prior unrelated session. When stdin lacks session_id (manual invocation,
# non-Claude-Code context) the hook emits a [SLOTLESS_SKIP] breadcrumb on
# stderr and is a full no-op — three ontologically distinct states (success,
# crash, deliberate skip) are kept legible per axiom #14.
#
# Claude runs this asynchronously; Codex runs it synchronously with a five-
# second outer timeout. Work here is local and bounded. Neither path produces
# output on failure (stderr slotless breadcrumb is the documented exception).
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

HOOK_HOST="claude"
if [[ "${1:-}" == "--host" && -n "${2:-}" ]]; then
  HOOK_HOST="$2"
fi
if [[ "${HOOK_HOST}" != "claude" && "${HOOK_HOST}" != "codex" ]]; then
  exit 0
fi

SESSION_CACHE_HELPER=""
for candidate in \
  "${PLUGIN_ROOT}/scripts/session_cache.py" \
  "${PLUGIN_ROOT}/scripts/client/session_cache.py"
do
  if [[ -f "${candidate}" ]]; then
    SESSION_CACHE_HELPER="${candidate}"
    break
  fi
done

if [[ -z "${SESSION_CACHE_HELPER}" ]]; then
  exit 0
fi

SLOT_HELPER="${PLUGIN_ROOT}/scripts/_slot_from_stdin.py"

_discard_snapshots() {
  local event_id="$1"
  [[ -z "${event_id}" ]] && return 0
  python3 "${SESSION_CACHE_HELPER}" discard-milestone-snapshot \
    --workspace "${PWD}" --slot "${SLOT}" --event-id "${event_id}" \
    >/dev/null 2>&1 || true
  python3 "${SESSION_CACHE_HELPER}" discard-session-snapshot \
    --workspace "${PWD}" --event-id "${event_id}" \
    >/dev/null 2>&1 || true
}

# Capture hook stdin (both hosts pass tool event JSON, including session_id).
HOOK_INPUT=""
if [[ ! -t 0 ]]; then
  HOOK_INPUT=$(cat 2>/dev/null) || true
fi

# Hook matchers are intentionally broad enough to cover every configured MCP
# alias. Enforce exact server ownership before any snapshot discard, milestone
# reset, or session stamp so a same-named tool on another server is inert.
IS_GOVERNANCE_CHECKIN=$(python3 - "${HOOK_INPUT}" "${PLUGIN_ROOT}/scripts" "${HOOK_HOST}" <<'PY' 2>/dev/null || true
import json
import sys

sys.path.insert(0, sys.argv[2])

from governance_tool_name import is_governance_tool

try:
    payload = json.loads(sys.argv[1])
except Exception:
    payload = {}
print(
    "1"
    if is_governance_tool(
        payload.get("tool_name"),
        host=sys.argv[3],
        suffixes={"process_agent_update", "sync_state"},
    )
    else "0"
)
PY
)
[[ "${IS_GOVERNANCE_CHECKIN}" == "1" ]] || exit 0

# Derive slot strictly from stdin session_id via the shared helper.
SLOT=""
if [[ -n "${HOOK_INPUT}" && -f "${SLOT_HELPER}" ]]; then
  SLOT=$(printf '%s' "${HOOK_INPUT}" | python3 "${SLOT_HELPER}" 2>/dev/null || true)
fi

# Slotless path: full no-op with a stderr breadcrumb. Pre-S20.1a, the hook
# would have written to flat session.json here — the auto-checkin forcing
# function depended on a stamp the next session-start would not read, so
# the path was producing the wrong artifact. Better to be visibly inert
# than invisibly wrong.
if [[ -z "${SLOT}" ]]; then
  printf '[SLOTLESS_SKIP] post-checkin: no session_id on stdin; milestone reset and last_checkin_ts not written\n' >&2
  exit 0
fi

# Require the PreToolUse snapshot keyed by this invocation. Payloads without a
# tool id cannot prove which authority generation completed and never consume
# the pending milestone.
TOOL_USE_ID=$(python3 - "${HOOK_INPUT}" <<'PY' 2>/dev/null || true
import json
import sys

try:
    payload = json.loads(sys.argv[1])
except Exception:
    payload = {}
print(str(payload.get("tool_use_id") or payload.get("tool_call_id") or ""))
PY
)

# PostToolUse also fires for failed MCP calls. Only an explicit successful
# UNITARES response acknowledges pending edits; missing, malformed, isError,
# or success=false results preserve the milestone and its timestamp.
CHECKIN_SUCCEEDED=$(python3 - "${HOOK_INPUT}" "${HOOK_HOST}" <<'PY' 2>/dev/null || true
import json
import sys

try:
    payload = json.loads(sys.argv[1])
except Exception:
    payload = {}


def explicit_success(value, depth=0):
    if depth > 4:
        return None
    if isinstance(value, list):
        verdicts = [explicit_success(part, depth + 1) for part in value]
        if False in verdicts:
            return False
        return True if True in verdicts else None
    if not isinstance(value, dict):
        return None
    if value.get("isError") is True:
        return False
    current = value.get("success")
    if current is False:
        return False
    nested = [
        explicit_success(value[key], depth + 1)
        for key in ("structuredContent", "result", "content")
        if key in value
    ]
    text = value.get("text")
    if isinstance(text, str):
        try:
            nested.append(explicit_success(json.loads(text), depth + 1))
        except Exception:
            pass
    if False in nested:
        return False
    if current is True or True in nested:
        return True
    return None


print("1" if explicit_success(payload.get("tool_response")) is True else "0")
PY
)
if [[ "${CHECKIN_SUCCEEDED}" != "1" ]]; then
  _discard_snapshots "${TOOL_USE_ID}"
  exit 0
fi

# A successful call acknowledges work only when its explicit proof equals the
# protected current-process HOME binding for this exact host slot. Workspace
# JSON is a compatibility mirror and is never an acknowledgement authority.
SESSION_PAYLOAD=$(python3 - "${HOOK_INPUT}" "${PLUGIN_ROOT}/scripts" <<'PY' 2>/dev/null || echo "{}"
import json
import os
import sys

sys.path.insert(0, sys.argv[2])
from _session_lookup import load_usable_session_for_hook

try:
    hook = json.loads(sys.argv[1])
except Exception:
    hook = {}
session = load_usable_session_for_hook(os.getcwd(), sys.argv[1])
tool_input = hook.get("tool_input") if isinstance(hook, dict) else None
supplied = tool_input.get("client_session_id") if isinstance(tool_input, dict) else None
expected = session.get("client_session_id") if isinstance(session, dict) else None
if not isinstance(expected, str) or not expected.strip():
    print("{}")
elif supplied is not None and (
    not isinstance(supplied, str) or supplied.strip() != expected.strip()
):
    print("{}")
else:
    print(json.dumps(session))
PY
)
if [[ -z "${SESSION_PAYLOAD}" || "${SESSION_PAYLOAD}" == "{}" ]]; then
  _discard_snapshots "${TOOL_USE_ID}"
  exit 0
fi

if [[ -z "${TOOL_USE_ID}" ]]; then
  exit 0
fi

NOW_EPOCH=$(python3 -c "import time; print(int(time.time()))" 2>/dev/null || echo "")
STAMP_PAYLOAD=$(python3 - "${SESSION_PAYLOAD}" "${NOW_EPOCH}" <<'PY' 2>/dev/null || echo "{}"
import json
import sys

try:
    session = json.loads(sys.argv[1])
    timestamp = int(sys.argv[2])
except Exception:
    print("{}")
else:
    print(json.dumps({
        "uuid": session.get("uuid"),
        "client_session_id": session.get("client_session_id"),
        "schema_version": 2,
        "last_checkin_ts": timestamp,
    }))
PY
)
if [[ -z "${NOW_EPOCH}" || "${STAMP_PAYLOAD}" == "{}" ]]; then
  _discard_snapshots "${TOOL_USE_ID}"
  exit 0
fi

# The pre-tool session snapshot carries both cache and authority generations.
# If the slot owner changed while the call was in flight, this CAS fails and
# the milestone remains pending for the new owner.
if ! python3 "${SESSION_CACHE_HELPER}" set session \
    --workspace "${PWD}" \
    --slot "${SLOT}" \
    --merge \
    --stamp \
    --snapshot-id "${TOOL_USE_ID}" \
    --json "${STAMP_PAYLOAD}" >/dev/null 2>&1; then
  python3 "${SESSION_CACHE_HELPER}" discard-milestone-snapshot \
    --workspace "${PWD}" --slot "${SLOT}" --event-id "${TOOL_USE_ID}" \
    >/dev/null 2>&1 || true
  exit 0
fi

python3 "${SESSION_CACHE_HELPER}" reset-milestone \
  --workspace "${PWD}" \
  --slot "${SLOT}" \
  --snapshot-id "${TOOL_USE_ID}" >/dev/null 2>&1 || true

exit 0
