#!/bin/sh
# thread-anchor-exec: launch one agent CLI turn bound to a conversation's
# governance identity.
#
#   scripts/thread-anchor-exec <thread-id> -- <cli> [args...]
#
# A chat bridge or orchestrator that starts a new CLI process for every turn
# gets a new UNITARES identity for every turn. This launcher declares the three
# variables the plugin's hooks require before they resume one identity for the
# whole conversation instead:
#
#   UNITARES_CLIENT_SESSION_ID       agent:/thread-<thread-id>
#   UNITARES_ORCHESTRATED            1
#   UNITARES_ORCHESTRATED_OWNER_PID  the PID of the CLI itself
#
# The third is why this is a script and not two lines of configuration. The
# hooks honor an anchor only in the process it was provisioned for, and they
# identify that process by PID. This shell is replaced by the CLI (`exec`), so
# its own PID is the CLI's. A CLI started any other way, including one this CLI
# starts later, has a different PID and is refused the anchor.
#
# Guide: docs/orchestrators.md
set -eu

usage() {
    printf '%s\n' \
        'usage: thread-anchor-exec <thread-id> -- <cli> [args...]' \
        '  <thread-id>  stable id of the conversation: ASCII letters, digits,' \
        '               _ and -, at most 128 characters' >&2
    exit 64
}

[ "$#" -ge 3 ] || usage
thread_id=$1
[ "$2" = "--" ] || usage
shift 2

# Every accepted id must reach the server unchanged. The server rewrites any
# character outside its safe set to `_` and collapses runs of dots, so two
# different ids could otherwise land on one identity. The characters are
# listed one by one because a range such as a-z follows the locale and admits
# accented letters under a UTF-8 one.
case "$thread_id" in
    ''|*[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-]*) usage ;;
esac
[ "${#thread_id}" -le 128 ] || usage

UNITARES_CLIENT_SESSION_ID="agent:/thread-$thread_id"
UNITARES_ORCHESTRATED=1
UNITARES_ORCHESTRATED_OWNER_PID=$$
export UNITARES_CLIENT_SESSION_ID UNITARES_ORCHESTRATED UNITARES_ORCHESTRATED_OWNER_PID

# An anchored turn resumes its conversation's identity. Lineage inherited from
# the bridge's own environment would describe some other process.
unset UNITARES_PARENT_AGENT_ID UNITARES_SPAWN_REASON

# Report a CLI that is missing (127) or cannot be run (126) here. What a shell
# does when `exec` itself fails differs from one shell to the next.
missing() {
    printf 'thread-anchor-exec: command not found: %s\n' "$1" >&2
    exit 127
}
case "$1" in
    */*) cli=$1 ;;
    *)
        cli=$(command -v -- "$1" 2>/dev/null) || missing "$1"
        # A name the shell also knows as a builtin resolves to no path; leave
        # that lookup to `exec`.
        case "$cli" in */*) ;; *) cli= ;; esac
        ;;
esac
if [ -n "$cli" ]; then
    [ -e "$cli" ] || missing "$1"
    if [ -d "$cli" ] || [ ! -x "$cli" ]; then
        printf 'thread-anchor-exec: cannot execute: %s\n' "$1" >&2
        exit 126
    fi
fi

exec "$@"
